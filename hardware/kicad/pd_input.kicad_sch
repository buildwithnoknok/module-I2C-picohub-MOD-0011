	(text "CH32X035G8U6 power manager: PD PHY on PC14/PC15,\nI2C slave to the Pico on PC16/PC17 (remap 2),\n2-wire SWD on PC18/PC19"
		(exclude_from_sim no)
		(at 204.978 58.42 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
		)
		(uuid "365022e2-7bf1-4e6c-ad24-7a68693e4d8a")
	)
	(text "Raspberry Pi Pico / Pico 2 W on 2x20 sockets.\nVSYS from +5V via SS34; micro-USB = programming only.\nI2C0 GP8/9 = bus A, I2C1 GP10/11 = bus B, PIO-USB GP16/17.\nSPI GP2/3/4/5, free IRQ from Mezzanine on GP6\nAGND (33) is tied to GND on the Pico itself - left NC here."
		(exclude_from_sim no)
		(at 315.214 56.388 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
		)
		(uuid "472d63f1-7513-4534-bef3-eb128ca2378c")
	)
	(text "MCUs & Pull-ups\n"
		(exclude_from_sim no)
		(at 159.004 37.592 0)
		(effects
