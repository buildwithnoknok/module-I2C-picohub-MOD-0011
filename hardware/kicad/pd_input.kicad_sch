				(bold yes)
			)
			(justify left)
		)
		(uuid "65878ae8-17ab-4573-9d73-4d82368bf054")
	)
	(text "USB-C PD input: external Rd on CC, 5 A PTC, 24 V TVS,\ninput current (shunt + INA180) and voltage sense, sink caps <= 10 uF"
